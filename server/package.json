{
  "name": "melann-lending-server",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Melann Lending System V2 - REST API Server",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/runTests.js \"test/**/*.test.js\"",
    "test:unit": "node scripts/runTests.js \"test/unit/**/*.test.js\"",
    "test:integration": "node scripts/runTests.js \"test/integration/**/*.test.js\"",
    "test:e2e": "node scripts/runTests.js \"test/e2e/**/*.test.js\"",
    "test:coverage": "node scripts/runTests.js --experimental-test-coverage --test-coverage-lines=65 --test-coverage-functions=65 --test-coverage-branches=50 \"test/**/*.test.js\"",
    "initialize:fresh": "node scripts/initializeFreshDatabase.js",
    "security:clear-initial-password": "node scripts/clearInitialAdminPassword.js",
    "verify:database": "node scripts/verifyDatabase.js",
    "verify:restore": "node scripts/verifyBackupRestore.js",
    "seed": "node src/db/seed.js",
    "import:jcash": "node import_jcash_good_status.js",
    "import:jcash-history": "node import_jcash_good_status.js --history --from 2024-01-01 --to 2026-06-26",
    "import:jcash-all": "node import_jcash_good_status.js --all",
    "verify:jcash-all": "node verify_jcash_all_import.js",
    "repair:running-balances": "node scripts/repairRunningBalances.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "sqlite3": "^6.0.1"
  }
}
